@import "tailwindcss";

:root {
  color-scheme: dark;
  --vbridge-navy-950: #061225;
  --vbridge-navy-900: #07162b;
  --vbridge-panel: #0a1a32;
  --vbridge-blue: #2563eb;
  --vbridge-cyan: #06b6d4;
}

* {
  box-sizing: border-box;
}

html {
  background: var(--vbridge-navy-950);
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-width: 320px;
  background:
    radial-gradient(
      circle at 10% 0%,
      rgba(37, 99, 235, 0.08),
      transparent 28%
    ),
    var(--vbridge-navy-950);
  color: #f8fafc;
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

button,
select {
  font: inherit;
}

button {
  -webkit-tap-highlight-color: transparent;
}

select option {
  background: #0b1d38;
  color: #eff6ff;
}

::selection {
  background: rgba(59, 130, 246, 0.35);
  color: #ffffff;
}

::-webkit-scrollbar {
  width: 9px;
  height: 9px;
}

::-webkit-scrollbar-track {
  background: #061225;
}

::-webkit-scrollbar-thumb {
  border: 2px solid #061225;
  border-radius: 999px;
  background: #1e3a5f;
}

::-webkit-scrollbar-thumb:hover {
  background: #28527f;
}
